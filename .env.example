# ==============================================================================
# AI Software Development Pipeline — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Telegram Bot
# Required: obtain from @BotFather
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone (NOT recommended for production).
# Example: 123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=

# Set to "true" to use Telegram webhook mode instead of long-polling.
# For local development, keep "false" and use polling.
TELEGRAM_USE_WEBHOOK=false

# The public base URL your server is reachable at (required for webhook mode).
# Example: https://pipeline.example.com
TELEGRAM_WEBHOOK_URL=

# Path Telegram will POST updates to (webhook mode only).
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# ------------------------------------------------------------------------------
# GitHub  (implemented in the next module — placeholders for now)
# ------------------------------------------------------------------------------

# Personal Access Token or GitHub App Installation Token.
GITHUB_TOKEN=ghp_your_github_token_here

# Owner of the target repository (username or org name).
GITHUB_OWNER=your-github-username

# Repository name (without owner prefix).
GITHUB_REPO=your-repository-name

# Secret used to verify GitHub webhook HMAC signatures.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Comma-separated GitHub Actions workflow names that count as pipeline CI.
# Leave empty to accept any completed workflow with success / failure / timed_out.
# Skipped, cancelled, and unrelated workflows are always ignored.
# Example: CI,Tests
GITHUB_CI_WORKFLOW_NAME=

# ------------------------------------------------------------------------------
# Coding Agent (GitHub Copilot)
# ------------------------------------------------------------------------------

# GitHub login used to detect Copilot comments (github-copilot[bot]).
# Assignment to the coding agent is always done as copilot-swe-agent[bot].
COPILOT_USERNAME=github-copilot[bot]

# Seconds between polling iterations when watching an issue for agent activity.
CODING_AGENT_POLL_INTERVAL=10.0

# Maximum seconds the issue watcher will run before timing out (default: 1 hour).
CODING_AGENT_WATCHER_TIMEOUT=3600.0

# Maximum retry attempts for each GitHub API call inside the coding agent adapter.
CODING_AGENT_MAX_RETRIES=3

# Per-request HTTP timeout in seconds for the coding agent adapter.
CODING_AGENT_REQUEST_TIMEOUT=15.0

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Runtime environment: development | staging | production
ENVIRONMENT=development
